# =============================================================================
# ResumAIner — Environment Variables Example
# =============================================================================
# Copy this file to your real .env and fill real values there.
#
# IMPORTANT:
# - This .env.example is safe to commit because it contains placeholders/test keys.
# - The real .env file MUST stay in .gitignore.
# - Never paste real secrets into ChatGPT/DeepSeek/OpenCode prompts.
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# PostgreSQL password (REQUIRED — no default in production)
DB_PASSWORD=changeme

# PostgreSQL user (optional — defaults to "resumainer")
DB_USER=resumainer

# PostgreSQL host (for app connection, use "db" when running in Docker)
DB_HOST=db

# PostgreSQL port (optional — defaults to 5432)
DB_PORT=5432

# =============================================================================
# Backend Application
# =============================================================================

# Spring active profile: dev or prod
# Local/dev: dev
# Docker/prod-like: prod
SPRING_PROFILES_ACTIVE=prod

# Backend server port
SERVER_PORT=8080

# =============================================================================
# Public URLs
# =============================================================================

# Existing/base public URL used by current public resume links.
# Keep this for backward compatibility until the code fully migrates away from it.
# Local Docker example:
APP_PUBLIC_BASE_URL=http://localhost:8080

# Backend public base URL used for server-generated links in emails
# such as email verification and password reset links.
APP_BACKEND_PUBLIC_BASE_URL=http://localhost:8080

# Frontend public base URL used for redirects after verification/reset.
# If your SPA is served by frontend nginx under /app:
APP_FRONTEND_PUBLIC_BASE_URL=http://localhost/app

# If you use Vite dev server instead, use this in your real .env:
# APP_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173/app

# =============================================================================
# Frontend
# =============================================================================

# Frontend Nginx port
FRONTEND_PORT=80

# =============================================================================
# Cloudflare Turnstile Captcha
# =============================================================================
# Phase 8 source of truth:
# - Site key is public and may be exposed to frontend.
# - Secret key is private and must be used only by backend.
# - For local automated tests, Cloudflare provides dummy test keys.
# - Replace dummy keys with real keys in your local .env when testing real Turnstile.

# Enable/disable captcha checks.
# dev can be false only for local convenience; prod must be true.
APP_CAPTCHA_ENABLED=true

# Captcha provider. Current expected provider: turnstile
APP_CAPTCHA_PROVIDER=turnstile

# Public Turnstile site key for frontend/Vite.
# Dummy "always passes" test site key for local/e2e:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional non-Vite alias if backend/templates ever need to expose the public site key.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Private Turnstile secret key for backend verification.
# Dummy "always passes" test secret key for local/e2e.
# In your real .env, replace this with the real Cloudflare Turnstile Secret Key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare Siteverify endpoint.
APP_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Backend timeout for the Turnstile verification HTTP call.
APP_TURNSTILE_TIMEOUT_MS=5000

# Development-only bypass token for non-browser/manual API testing.
# Backend may accept this token only when dev bypass is explicitly enabled.
# Prod must never accept this bypass.
APP_CAPTCHA_DEV_BYPASS_ENABLED=true
APP_CAPTCHA_DEV_TOKEN=dev-captcha-pass

# Login security thresholds.
APP_AUTH_LOGIN_CAPTCHA_AFTER_FAILED_ATTEMPTS=3
APP_AUTH_LOGIN_LOCK_AFTER_FAILED_ATTEMPTS=5
APP_AUTH_LOGIN_LOCK_MINUTES=15

# =============================================================================
# Resend Email
# =============================================================================
# Phase 9 source of truth:
# - Domain is verified in Resend: send.resumainer.com
# - API key is private and must be used only by backend.
# - Sender format accepted by Resend: Friendly Name <sender@verified-domain>
# - Never expose RESEND_API_KEY to frontend or logs.

APP_EMAIL_PROVIDER=resend

# Safe example sender from verified Resend domain.
# If your dotenv loader keeps quotes as part of the value, remove the quotes in real .env.
APP_EMAIL_FROM="ResumAIner <noreply@send.resumainer.com>"

# Real API key format: re_xxxxxxxxxxxxxxxxx
# Keep placeholder in .env.example. Put the real value only in your local .env.
RESEND_API_KEY=

# Resend API base URL and timeout.
RESEND_API_BASE_URL=https://api.resend.com
APP_EMAIL_TIMEOUT_MS=10000

# Dev fallback:
# In dev, if RESEND_API_KEY is missing, backend may log verification/reset links.
# In prod, missing RESEND_API_KEY must fail loudly/safely and must not silently no-op.
APP_EMAIL_LOG_LINKS_WHEN_API_KEY_MISSING=true

# =============================================================================
# Auth Tokens / Email Verification / Password Reset
# =============================================================================

# Email verification token TTL: 24 hours
APP_AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440

# Password reset token TTL: 15 minutes
APP_AUTH_PASSWORD_RESET_TTL_MINUTES=15

# Resend verification email throttling
APP_AUTH_RESEND_COOLDOWN_SECONDS=60
APP_AUTH_RESEND_MAX_PER_HOUR=5
APP_AUTH_RESEND_MAX_PER_DAY=20

# Password reset throttling
APP_AUTH_PASSWORD_RESET_MAX_PER_IP_15M=5
APP_AUTH_PASSWORD_RESET_MAX_PER_EMAIL_15M=3

# =============================================================================
# OAuth / Google Login — placeholders for later phases only
# =============================================================================
# Do not implement or use these in Phase 8 unless the phase explicitly asks.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
