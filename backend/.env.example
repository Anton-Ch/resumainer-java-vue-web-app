# ResumAIner Backend — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# Active Spring profile: dev for local, prod for deployment
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resumainer
DB_USER=resumainer
DB_PASSWORD=resumainer_dev

# Cloudflare Turnstile captcha (dev bypass: dev-captcha-pass)
TURNSTILE_SECRET_KEY=
APP_CAPTCHA_DEV_BYPASS_ENABLED=true
APP_CAPTCHA_DEV_TOKEN=dev-captcha-pass

# Resend email (dev fallback logs instead of sending)
RESEND_API_KEY=
APP_EMAIL_FROM=ResumAIner <noreply@send.resumainer.com>
APP_EMAIL_DEV_FALLBACK_ENABLED=true

# Public URLs (used in email templates)
APP_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
APP_BACKEND_PUBLIC_BASE_URL=http://localhost:8080

# Immediate trusted reverse proxy host (Docker Compose service name in deployment)
APP_AUTH_TRUSTED_PROXY_HOSTS=frontend
